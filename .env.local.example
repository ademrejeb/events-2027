# Copy this file to .env.local and fill in your project credentials.
# Local: run `npx supabase start`, then `npm run db:local-env`.
# Hosted: Supabase Dashboard > Project Settings > API keys.
# NEVER commit real keys. .env.local is git-ignored.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Server-only. Use the publishable/anon key, never a secret/service key.
SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Server-only. Full access, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-server-only>

# 32+ character secret used to encrypt social access tokens at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Set to 1 only when the app sits behind a trusted reverse proxy that sets
# x-forwarded-for (used by the per-instance rate limiter).
TRUST_PROXY=0
