# @adem.rejeb/ui still declares lucide-react <1.0 as a peer; this app runs 1.x
# (installed and verified locally). Install with the same resolution in CI.
legacy-peer-deps=true

# Render reuses /opt/render/.cache between builds; a corrupted npm cache entry
# there makes `npm ci` fail with EINTEGRITY even though the lockfile is valid.
# Use an ephemeral cache so every build starts clean.
cache=/tmp/npm-cache-yed-lkhir
